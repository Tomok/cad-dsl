// Rune block executed multiple times with different inputs
// Tests that execution results are NOT cached (only compilation is cached)
let x1: i32;
let x2: i32;
let x3: i32;

x1 == 10;
x2 == 20;
x3 == 30;

// Each rune block uses the same code but different parameter
let result1 = rune(x1) { x1 * 2 };
let result2 = rune(x2) { x2 * 2 };
let result3 = rune(x3) { x3 * 2 };
